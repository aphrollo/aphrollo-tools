# Embedded templates are read as raw bytes by go:embed; a CRLF checkout must never change them.
*.md text eol=lf
*.go text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Golden lines are compared byte for byte, newlines included; a CRLF checkout must never change them.
internal/render/testdata/*.golden -text
# Captured `git status -z` output is NUL-separated bytes compared as they are; no checkout may convert it.
internal/git/testdata/** -text
